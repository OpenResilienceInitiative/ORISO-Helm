#!/bin/sh
# Reconciles the Keycloak service identities of ORISO (ORISO-Helm#367) on every
# install AND upgrade. `--import-realm` skips existing realms, so without this a
# role change in realm.json never reaches Dev, Staging or Prod.
#
# Idempotent: re-running converges to the same state. Role sets are EXACT for
# realm roles and realm-management client roles: anything not listed is removed.
#
# Expects an authenticated kcadm session (kcadm config credentials) and:
#   KEYCLOAK_REALM            target realm
#   SERVICE_ADMIN_USERNAME    backend Keycloak admin identity
#   SERVICE_ADMIN_PASSWORD    its password (from the deployment's secret values)
#   TECHNICAL_USERNAME        the UserService's service identity (password is
#                             owned by keycloak-bootstrap-users, not set here)
#   TECHNICAL_SERVICE_SUBJECT expected Keycloak id of that identity; checked
#                             BEFORE any change, a mismatch fails the job
#   BOOTSTRAP_ADMIN_USERNAME  the deployment-time admin (realmadmin); the backend
#                             admin identity must never be that account
#   KCADM                     kcadm path (default /opt/keycloak/bin/kcadm.sh)
set -eu

KCADM="${KCADM:-/opt/keycloak/bin/kcadm.sh}"
: "${KEYCLOAK_REALM:?KEYCLOAK_REALM is required}"
: "${SERVICE_ADMIN_USERNAME:?SERVICE_ADMIN_USERNAME is required}"
: "${SERVICE_ADMIN_PASSWORD:?SERVICE_ADMIN_PASSWORD is required}"
: "${TECHNICAL_USERNAME:?TECHNICAL_USERNAME is required}"
: "${TECHNICAL_SERVICE_SUBJECT:?TECHNICAL_SERVICE_SUBJECT is required}"
: "${BOOTSTRAP_ADMIN_USERNAME:?BOOTSTRAP_ADMIN_USERNAME is required}"

# One wrong value must not strip realm-admin from the bootstrap admin or merge
# the admin identity into the service identity. Keycloak usernames are
# case-insensitive, so compare lower-cased.
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
for reserved in "$TECHNICAL_USERNAME" "$BOOTSTRAP_ADMIN_USERNAME" technical realmadmin; do
  if [ "$(lower "$SERVICE_ADMIN_USERNAME")" = "$(lower "$reserved")" ]; then
    echo "ERROR: SERVICE_ADMIN_USERNAME (global.secrets.keycloakServiceAdminUsername) is '${SERVICE_ADMIN_USERNAME}'," >&2
    echo "which is the service identity or the bootstrap admin. Use a dedicated user, e.g. svc-keycloak-admin." >&2
    exit 4
  fi
done

OTP_CONFIG_ADMIN_ROLE="otp-config-admin"
SERVICE_ADMIN_REALM_ROLES="default-roles-${KEYCLOAK_REALM} ${OTP_CONFIG_ADMIN_ROLE}"
# view-realm: the UserService reads realm roles by name before mapping them.
SERVICE_ADMIN_MANAGEMENT_ROLES="manage-users view-users query-users view-realm"
# Pure service identity: the services map `technical` to narrow authorities.
TECHNICAL_REALM_ROLES="default-roles-${KEYCLOAK_REALM} technical"
TECHNICAL_MANAGEMENT_ROLES=""
# No service reads this realm role; they derive their authority from `technical`.
RETIRED_REALM_ROLES="TECHNICAL_DEFAULT"

contains() {
  # contains "<space separated list>" <word>
  for candidate in $1; do
    [ "$candidate" = "$2" ] && return 0
  done
  return 1
}

ensure_realm_role() {
  name="$1"
  description="$2"
  if "$KCADM" get "roles/${name}" -r "$KEYCLOAK_REALM" >/dev/null 2>&1; then
    return 0
  fi
  "$KCADM" create roles -r "$KEYCLOAK_REALM" -s "name=${name}" -s "description=${description}"
  echo "created realm role ${name}"
}

user_id() {
  "$KCADM" get users -r "$KEYCLOAK_REALM" -q exact=true -q "username=$1" --fields id --format csv --noquotes \
    | head -n1
}

ensure_user() {
  username="$1"
  password="$2"
  uid="$(user_id "$username" || true)"
  if [ -z "$uid" ]; then
    "$KCADM" create users -r "$KEYCLOAK_REALM" -s "username=${username}" -s enabled=true
    echo "created user ${username}"
  else
    "$KCADM" update "users/${uid}" -r "$KEYCLOAK_REALM" -s enabled=true -s 'requiredActions=[]'
  fi
  "$KCADM" set-password -r "$KEYCLOAK_REALM" --username "$username" --new-password "$password" --temporary=false
}

# list_roles <username> [--cclientid realm-management]: fails loudly; `for x in $(...)`
# would swallow a kcadm error under set -e and silently remove nothing.
list_roles() {
  list_user="$1"
  shift
  if ! listed="$("$KCADM" get-roles -r "$KEYCLOAK_REALM" --uusername "$list_user" "$@" --fields name --format csv --noquotes)"; then
    echo "ERROR: could not list roles of ${list_user} $*" >&2
    exit 5
  fi
  printf '%s\n' "$listed"
}

# reconcile_roles <username> "<wanted realm roles>" "<wanted realm-management roles>"
reconcile_roles() {
  username="$1"
  wanted_realm="$2"
  wanted_management="$3"

  for role in $wanted_realm; do
    "$KCADM" add-roles -r "$KEYCLOAK_REALM" --uusername "$username" --rolename "$role"
  done
  for role in $wanted_management; do
    "$KCADM" add-roles -r "$KEYCLOAK_REALM" --uusername "$username" --cclientid realm-management --rolename "$role"
  done

  current_realm="$(list_roles "$username")" || exit 5
  for role in $current_realm; do
    if ! contains "$wanted_realm" "$role"; then
      "$KCADM" remove-roles -r "$KEYCLOAK_REALM" --uusername "$username" --rolename "$role"
      echo "removed realm role ${role} from ${username}"
    fi
  done
  current_management="$(list_roles "$username" --cclientid realm-management)" || exit 5
  for role in $current_management; do
    if ! contains "$wanted_management" "$role"; then
      "$KCADM" remove-roles -r "$KEYCLOAK_REALM" --uusername "$username" --cclientid realm-management --rolename "$role"
      echo "removed realm-management role ${role} from ${username}"
    fi
  done
  echo "reconciled roles of ${username}"
}

# Checked before any change: a wrong value must not leave a half-reconciled realm.
if ! actual_subject="$(user_id "$TECHNICAL_USERNAME")"; then
  echo "ERROR: could not look up ${TECHNICAL_USERNAME}" >&2
  exit 5
fi
if [ "$actual_subject" != "$TECHNICAL_SERVICE_SUBJECT" ]; then
  echo "ERROR: ${TECHNICAL_USERNAME} has Keycloak id '${actual_subject}', but" >&2
  echo "global.keycloak.serviceTechUserId (TECHNICAL_SERVICE_SUBJECT) is ${TECHNICAL_SERVICE_SUBJECT}." >&2
  echo "TenantService would not recognise the technical user. Set the value to the live id. Nothing was changed." >&2
  exit 3
fi
echo "technical subject matches ${TECHNICAL_USERNAME}"

ensure_realm_role "$OTP_CONFIG_ADMIN_ROLE" \
  "May call the otp-config endpoints of the ORISO Keycloak SPI (backend Keycloak admin identity only)"

ensure_user "$SERVICE_ADMIN_USERNAME" "$SERVICE_ADMIN_PASSWORD"
reconcile_roles "$SERVICE_ADMIN_USERNAME" "$SERVICE_ADMIN_REALM_ROLES" "$SERVICE_ADMIN_MANAGEMENT_ROLES"

reconcile_roles "$TECHNICAL_USERNAME" "$TECHNICAL_REALM_ROLES" "$TECHNICAL_MANAGEMENT_ROLES"

for role in $RETIRED_REALM_ROLES; do
  if "$KCADM" get "roles/${role}" -r "$KEYCLOAK_REALM" >/dev/null 2>&1; then
    "$KCADM" delete "roles/${role}" -r "$KEYCLOAK_REALM"
    echo "deleted retired realm role ${role}"
  fi
done
