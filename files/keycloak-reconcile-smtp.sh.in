#!/bin/sh
# Keycloak imports realm.json only for new realms. Reconcile SMTP on every
# install/upgrade so OTP mail uses the same deployment-owned source as UserService.
set -eu

KCADM="${KCADM:-/opt/keycloak/bin/kcadm.sh}"
: "${KEYCLOAK_REALM:?KEYCLOAK_REALM is required}"
: "${SMTP_HOST:?SMTP_HOST is required for Keycloak mail}"
: "${SMTP_PORT:?SMTP_PORT is required for Keycloak mail}"
: "${SMTP_SECURE:?SMTP_SECURE is required for Keycloak mail}"
: "${SMTP_FROM:?SMTP_FROM is required for Keycloak mail}"
: "${SMTP_USER:?SMTP_USER is required for Keycloak mail}"
: "${SMTP_PASSWORD:?SMTP_PASSWORD is required for Keycloak mail}"

case "$SMTP_SECURE" in
  true) smtp_ssl=true; smtp_starttls=false ;;
  false) smtp_ssl=false; smtp_starttls=true ;;
  *) echo 'ERROR: SMTP_SECURE must be true or false' >&2; exit 2 ;;
esac

case "$SMTP_FROM" in
  *'<'*'>' )
    smtp_from=${SMTP_FROM##*<}
    smtp_from=${smtp_from%>}
    smtp_from_name=${SMTP_FROM%%<*}
    smtp_from_name=$(printf '%s' "$smtp_from_name" | sed 's/[[:space:]]*$//')
    ;;
  *) smtp_from=$SMTP_FROM; smtp_from_name='' ;;
esac
case "$smtp_from" in
  *@*.*) ;;
  *) echo 'ERROR: SMTP_FROM must contain an email address' >&2; exit 2 ;;
esac

# Environment values may contain quotes or backslashes. Refuse control bytes
# and encode the remaining values as JSON without putting either secret in argv.
for value in "$SMTP_HOST" "$SMTP_PORT" "$smtp_from" "$smtp_from_name" "$SMTP_USER" "$SMTP_PASSWORD"; do
  case "$value" in
    *'
'*) echo 'ERROR: SMTP configuration contains a newline' >&2; exit 2 ;;
  esac
  if [ -n "$(printf '%s' "$value" | LC_ALL=C sed -n '/[[:cntrl:]]/p')" ]; then
    echo 'ERROR: SMTP configuration contains a control character' >&2
    exit 2
  fi
done

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

{
  printf '{"smtpServer":{'
  printf '"host":'; json_string "$SMTP_HOST"; printf ','
  printf '"port":'; json_string "$SMTP_PORT"; printf ','
  printf '"ssl":'; json_string "$smtp_ssl"; printf ','
  printf '"starttls":'; json_string "$smtp_starttls"; printf ','
  printf '"auth":"true",'
  printf '"from":'; json_string "$smtp_from"; printf ','
  printf '"fromDisplayName":'; json_string "$smtp_from_name"; printf ','
  printf '"user":'; json_string "$SMTP_USER"; printf ','
  printf '"password":'; json_string "$SMTP_PASSWORD"
  printf '}}'
} | "$KCADM" update "realms/${KEYCLOAK_REALM}" -f - >/dev/null
echo 'reconciled Keycloak SMTP from deployment settings'
