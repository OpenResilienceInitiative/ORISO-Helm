
cert-manager:
  enabled: true

global:

  domainName: "your-domain.example.com"
  # Empty = cluster default StorageClass.
  storageClass: ""
  # Override per environment only for immutable tags/digests.
  imagePullPolicy: "Always"
  # Coordinated releases set this to true through the generated digest overlay.
  requireImmutableImages: false
  domains:
    matrix: "matrix.your-domain.example.com"
    auth: "http://keycloak:8080/"

  # OTLP export to SigNoz — auto-enabled when signoz.enabled=true.
  observability:
    otlpEnabled: false
    autoEnableWithSignoz: true
    deploymentEnvironment: "pre-dev"   # environment tag on exported signals
    otlpCollectorHost: "" # optional external collector host:port when signoz.enabled=false

  acmedomainName: "acme.your-domain.example.com"
 #adminDomainName: "admin.your-domain.example.com"
  internal:
    keycloakURL: "http://keycloak:8080/"
  external:
    keycloakURL: "https://your-domain.example.com/auth/"

  springSecurityOAuth2ResourceserverJWTIssuerURI: "https://your-domain.example.com/auth/realms/your-realm"
  springSecurityOAuth2ResourceserverJWTJWKSETURI: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/certs"
  authorizationendpoint: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/auth"
  tokenendpoint: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/token"
  userinfoendpoint: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/userinfo"

  # TLS
  enableTls: true
  enableLiquibase: "true"
  # CORS
  enableCors: false
  corsAllowOrigin:
  corsAllowHeaders:

  #services to nginx
  nginxServiceURL: "http://cob-proxy:8089/"
  internalUseHTTPS: "false"
  useAPIURL: "true"

  keycloakAuthServerUrl: "http://keycloak:8080/"
  ServiceURL: "http://mongodb:27017"
  # CSRF
  csrfCookieProperty: "CSRF-TOKEN"
  csrfHeaderProperty: "X-CSRF-TOKEN"
  csrfWhitelistHeaderProperty: "X-U25-CSRF-TOKEN"

  multitenancyEnabled: true
  multitenancyWithSingleDomainEnabled: "true"

  topicsEnabled: "true"
  featureTopicsEnabled: "true"
  statisticsEnabled: "true"
  demographicsEnabled: "false"

  # No dummy seeding here — the dev overlay (values-dev.yaml) turns this on.
  initializeDummyData: false

  logstashHost: "http://logstash.default:8080"

  # Needed by subcharts; admin credentials go under global.matrix in secrets.yaml.
  matrix:
    matrixServerName: "your-server.local"

  # Keycloak connection
  keycloak:
    realm: "your-realm"
    authServerUrl: "https://your-domain.example.com/auth"
    otpUrl: "/realms/your-realm/otp-config"
    openidConnectUrl: "/realms/your-realm/protocol/openid-connect"
    loginSuffix: "/token"
    logoutSuffix: "/logout"
    principalAttribute: "preferred_username"
    serviceAppClientId: "app"
    serviceAdminClientId: "admin-cli"
    bootstrapUsers:
      enabled: true

matrix:
  image: "matrixdotorg/synapse:v1.158.0"
  initImage: "busybox:1.38.0"
  replicas: 1
  postgresReplicas: 1
  synapseServerName: "your-server.local"
  synapseReportStats: "no"
  synapseEnableAuthenticatedMedia: "false"
  matrixApiUrl: "http://matrix-synapse:8008"
  matrixServerName: "your-server.local"
  # Public IP exempt from Synapse rate limiting; set per environment (ADR-005).
  serverPublicIp: ""

elementCall:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/element-call:dev"
  healthcheckImage: "docker.io/curlimages/curl@sha256:9a1ed35addb45476afa911696297f8e115993df459278ed036182dd2cd22b67b"

# ---------- Infrastructure Services ----------------------------------------------------------------------------------

admin:
  replicas: 1
  imageName: "ghcr.io/openresilienceinitiative/oriso-admin"
  imageVersion: "dev"
# MongoDB
online-counseling-mongodb:
  imageName: "mongo"
  imageVersion: "5.0"

# MariaDB
online-counseling-mariadb:
  imageName: "mariadb"
  imageVersion: "11.0.6"
  maxconnections: "1000"
matrixrtcAuth:
  replicas: 1
  membershipReaderUserId: "@matrixrtc-auth:your-server.local"
  # Namespace of the ingress controller, needed by the NetworkPolicy.
  ingressControllerNamespace: "ingress-nginx"
  existingSecret:
    # Pre-provision this Secret outside Helm. Sensitive values must never enter
    # rendered manifests or Helm release history.
    name: "matrixrtc-auth-runtime"
    membershipTokenKey: "matrix-membership-token"
    callPolicyTokenKey: "call-policy-token"
    livekitApiKeyKey: "livekit-api-key"
    livekitApiSecretKey: "livekit-api-secret"
    redisUrlKey: "redis-url"
  # Pinned by digest — these images are the LiveKit authorization boundary.
  gateway:
    image: "ghcr.io/openresilienceinitiative/matrixrtc-auth-policy-gateway@sha256:2bc86a3a178d26fbc8ab09887c75bc2f1dd8e2b6e41cacf836bad060124fec06"
    pullPolicy: ""
  upstream:
    image: "ghcr.io/openresilienceinitiative/matrixrtc-authorization-service@sha256:d62ecfd22cfbc2081d3814e63fc7fe2d969aab9fbba54881cd51552d971fd714"
    pullPolicy: ""
  service:
    port: 3010
    targetPort: 3010
    type: ClusterIP

livekit:
  replicas: 1
  # hostNetwork ports — the replica must fully terminate before its replacement starts.
  deploymentStrategy: Recreate
  terminationGracePeriodSeconds: 60
  image: "docker.io/livekit/livekit-server@sha256:3497163e15c48fef6e7830c78716f9e9d5edc28abf7aa90b61c86e93bbc306b1"
  existingConfigSecret:
    # Pre-provision this Secret outside Helm for the same release-history boundary.
    name: "livekit-config-runtime"
    key: "config.yaml"

# RabbitMQ
online-counseling-rabbitmq:
  imageName: "rabbitmq"
  imageVersion: "3-management"

# Redis
online-counseling-redis:
  imageName: "redis"
  imageVersion: "7-alpine"
  serviceURL: "redis://redis:6379"

# Keycloak
online-counseling-keycloak:
  imageName: "ghcr.io/openresilienceinitiative/oriso-keycloak"
  imageVersion: "26.6.3-otp"

  dbVendor: "mariadb"
  dbServer: "mariadb"
  dbDatabase: "keycloak"

  # Log levels: ALL, DEBUG, ERROR, FATAL, INFO, OFF, TRACE, WARN
  keycloakLogLevel: "WARN"
  rootLogLevel: "WARN"


# ---------- Backend Services -----------------------------------------------------------------------------------------


# Agency service
agencyService:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-agencyservice:dev"

  keycloakResource: "agency-service"

  springProfilesActive: "prod"
  liquibaseChangeLog: "classpath:db/changelog/agencyservice-master.xml"
  liquibaseContexts: "seed"

  topicEnrichmentEnabled: "false"

  agencyDeleteworkflowCron: "0 20 4 * * *"


# ConsultingType service
consultingTypeService:
  replicas: 1
  imageName: "ghcr.io/openresilienceinitiative/oriso-consultingtypeservice"
  imageVersion: "dev"
  serviceURL: "http://consultingtypeservice:8080"

  keycloakResource: "consultingtype-service"

  consultingTypesJsonPath : "consulting-type-settings"
  liquibaseChangeLog: "classpath:db/changelog/consultingtypeservice-master.xml"
  liquibaseContexts: "seed"
  bootstrapTopics:
    enabled: true


# Tenant Service
tenantService:
  replicas: 1
  imageName: "ghcr.io/openresilienceinitiative/oriso-tenantservice"
  imageVersion: "dev"
  springProfilesActive: "prod"
  liquibaseChangeLog: "classpath:db/changelog/tenantservice-master.xml"
  liquibaseContexts: "seed"
  bootstrapTenants:
    enabled: true
  springDatasourceURL: "jdbc:mariadb://mariadb:3306/tenantservice"
  springRabbitmqHost: "rabbitmq"
  springRabbitmqPort: "5672"


# User service
userService:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-userservice:dev"
  serviceURL: "http://userservice:8080"

  keycloakResource: "user-service"

  springProfilesActive: "prod"

  # Encryption must never be disabled in any environment.
  matrixEncryptionEnabled: "true"

  springRabbitmqHost: "rabbitmq"
  springRabbitmqPort: "5672"

  redisHost: "redis"
  redisPort: 6379
  consultantAvailabilityRedisTtlSeconds: 120

  # ADR-018 Global Support Access — see runbooks/support-access-enablement.md.
  supportAccess:
    enabled: "false"
    handshakeTtlSeconds: 300
    sessionTtlHours: 4
    auditRetentionMonths: 12

  # 2FA / OTP login posture — enabled by default.
  otpAllowedForUsers: "true"
  otpAllowedForConsultants: "true"
  otpAllowedForSingleTenantAdmins: "true"
  otpAllowedForTenantSuperAdmins: "true"

  # Must be overridden per environment; password reset fails closed if unset.
  magicLinkFrontendBaseUrl: "https://your-domain.example.com"
  passwordResetFrontendBaseUrl: "https://your-domain.example.com"
  passwordResetAdminFrontendBaseUrl: "https://admin.your-domain.example.com/admin"

  # SMTP is environment-owned; setting a host requires credentials in secrets.
  smtpHost: ""
  smtpPort: 587
  smtpSecure: false
  smtpFrom: ""

  # Bare origins for account-invite links (TEN-INV-U6/U7); unset = system-notification base URL.
  # accountInviteAppFrontendBaseUrl: "https://your-domain.example.com"
  # accountInviteAdminFrontendBaseUrl: "https://admin.your-domain.example.com"

  firebaseConfigurationCredentialsFilePath: "/firebase/firebase-credentials.json"
  firebaseConfigurationNotificationMessage: "Du hast eine neue Nachricht erhalten"

  consultantImportFilename: "import/consultants.csv"
  consultantImportProtocolFilename: "import/consultants-import.txt"
  askerImportFilename: "import/askers.csv"
  askerImportWithoutSessionFilename: "import/askers-without-session.csv"
  askerImportProtocolFilename: "import/askers-import.txt"
  askerImportWelcomeMessageFilename: "import/welcome_consulting_type_[ConsultingType].txt"
  askerImportWelcomeMessageFilenameReplaceValue: "[ConsultingType]"

  sessionInactiveDeleteWorkflowEnabled: "false"
  sessionInactiveDeleteWorkflowCron: "0 0 * * * ?"
  sessionInactiveDeleteWorkflowCheckDays: "30"

# ---------- Frontend Services ----------------------------------------------------------------------------------------

# Frontend
frontend:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-frontend:dev"

nginxController:
  enabled: true
  replicas: 1


# ---------- Observability & Monitoring -------------------------------------------------------------------------------

# SigNoz — set signoz.enabled=true to deploy it and auto-enable OTLP export.
signoz:
  enabled: false
  # UI is served at https://<global.domainName>/signoz — keep in sync per environment.
  signoz:
    env:
      signoz_global_external__url: "https://your-domain.example.com/signoz"
  telemetryStoreMigrator:
    upgradeHelmHooks: false
  clickhouse:
    persistence:
      size: 20Gi

# Health Dashboard
healthDashboard:
  image:
    repository: ghcr.io/openresilienceinitiative/health-dashboard
    tag: dev
    pullPolicy: ""
  replicas: 1
  namespace: ""
  resources: {}
  service:
    type: ClusterIP
    port: 9100
    targetPort: 9100
  env:
    PORT: "9100"
    HEALTH_CHECK_TIMEOUT_MS: "5000"
