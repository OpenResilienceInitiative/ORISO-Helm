
cert-manager:
  enabled: true

global:

  # REQUIRED: public host name of this installation (e.g. app.example.org; no
  # scheme, no path). Every public URL, mail link and ingress host derives from
  # it. Empty or a placeholder fails `helm install` on purpose.
  domainName: ""
  # Empty = cluster default StorageClass.
  storageClass: ""
  # Override per environment only for immutable tags/digests.
  imagePullPolicy: "Always"
  domains:
    matrix: "matrix.your-domain.example.com"
    auth: "http://keycloak:8080/"

  # OTLP export to SigNoz — auto-enabled when signoz.enabled=true.
  observability:
    otlpEnabled: false
    autoEnableWithSignoz: true
    deploymentEnvironment: "pre-dev"   # environment tag on exported signals
    otlpCollectorHost: "" # optional external collector host:port when signoz.enabled=false

  acmedomainName: "acme.your-domain.example.com"
 #adminDomainName: "admin.your-domain.example.com"
  internal:
    keycloakURL: "http://keycloak:8080/"
  external:
    keycloakURL: "https://your-domain.example.com/auth/"

  springSecurityOAuth2ResourceserverJWTIssuerURI: "https://your-domain.example.com/auth/realms/your-realm"
  springSecurityOAuth2ResourceserverJWTJWKSETURI: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/certs"
  authorizationendpoint: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/auth"
  tokenendpoint: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/token"
  userinfoendpoint: "http://keycloak:8080/auth/realms/your-realm/protocol/openid-connect/userinfo"

  # TLS
  enableTls: true
  enableLiquibase: "true"
  # CORS
  enableCors: false
  corsAllowOrigin:
  corsAllowHeaders:

  #services to nginx
  nginxServiceURL: "http://cob-proxy:8089/"
  internalUseHTTPS: "false"
  useAPIURL: "true"

  keycloakAuthServerUrl: "http://keycloak:8080/"
  ServiceURL: "http://mongodb:27017"
  # CSRF
  csrfCookieProperty: "CSRF-TOKEN"
  csrfHeaderProperty: "X-CSRF-TOKEN"
  csrfWhitelistHeaderProperty: "X-U25-CSRF-TOKEN"

  multitenancyEnabled: true
  multitenancyWithSingleDomainEnabled: "true"

  topicsEnabled: "true"
  featureTopicsEnabled: "true"
  statisticsEnabled: "true"
  demographicsEnabled: "false"

  # No dummy seeding here — the dev overlay (values-dev.yaml) turns this on.
  initializeDummyData: false

  logstashHost: "http://logstash.default:8080"

  # Needed by subcharts; admin credentials go under global.matrix in secrets.yaml.
  matrix:
    matrixServerName: "your-server.local"

  # Keycloak connection
  keycloak:
    realm: "your-realm"
    authServerUrl: "https://your-domain.example.com/auth"
    otpUrl: "/realms/your-realm/otp-config"
    openidConnectUrl: "/realms/your-realm/protocol/openid-connect"
    loginSuffix: "/token"
    logoutSuffix: "/logout"
    principalAttribute: "preferred_username"
    serviceAppClientId: "app"
    serviceAdminClientId: "admin-cli"
    bootstrapUsers:
      enabled: true
    # Checks after every install and upgrade that the live realm still carries
    # the ORISO 2FA contract, and fails the hook when it does not. It never
    # writes to the realm: reconciling stays a deliberate operator action,
    # because the apply script rebinds to the stock flow and recreates the
    # custom one, which would break 2FA logins for the duration of every
    # deploy. Set to false only to silence it temporarily.
    verifyTwoFactorContract:
      enabled: true
      # Admin API as reached from INSIDE the cluster. Deliberately not
      # authServerUrl above: that is the public ingress URL, and a hook that
      # leaves the cluster to come back in fails whenever the ingress is not up
      # yet — which during a deploy is exactly when this job runs.
      # The whole endpoint is here rather than defaulted in the template, so an
      # environment that answers elsewhere changes one line and sees what it is
      # changing. {{ .Release.Namespace }} is resolved at render time; the rest
      # is literal. Empty fails the render rather than guessing an address.
      adminUrl: "http://keycloak.{{ .Release.Namespace }}:8080/auth"
      # Tries at 5s intervals before giving up on the admin API. Helm's
      # --timeout only stops helm waiting, it never stops this pod, so the
      # bound has to live here.
      waitAttempts: 60
      # Kubernetes-side deadline for the whole job, covering a hang anywhere
      # the retry bound does not reach.
      deadlineSeconds: 600
      # The check script ships inside the oriso-keycloak image. Images built
      # before it existed make the job skip and exit 0, which is honest while
      # that is the rolled-out image and misleading forever after: a job that
      # can only ever succeed reads like a passing check. Set to true once an
      # image carrying /opt/keycloak/bin/oriso-verify-2fa-flow.sh is deployed,
      # and a missing script fails the release instead of being waved through.
      requireCheckScript: false

matrix:
  image: "matrixdotorg/synapse:v1.158.0"
  initImage: "busybox:1.38.0"
  replicas: 1
  postgresReplicas: 1
  synapseServerName: "your-server.local"
  synapseReportStats: "no"
  synapseEnableAuthenticatedMedia: "false"
  matrixApiUrl: "http://matrix-synapse:8008"
  matrixServerName: "your-server.local"
  # Public IP exempt from Synapse rate limiting; set per environment (ADR-005).
  serverPublicIp: ""

elementCall:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/element-call:dev"
  healthcheckImage: "docker.io/curlimages/curl@sha256:9a1ed35addb45476afa911696297f8e115993df459278ed036182dd2cd22b67b"

# Storybook is a development surface and stays absent unless an environment
# explicitly enables it together with an ingress authentication secret.
storybook:
  enabled: false
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-storybook:dev"
  adminImage: "ghcr.io/openresilienceinitiative/oriso-storybook:dev"
  pullPolicy: Always
  imagePullSecrets: []
  resources: {}
  ingress:
    authSecret: ""
    authRealm: "ORISO Storybook"

# ---------- Media security (epic ORISO-Admin#366, ADR-019) -----------------------------------------------------------

# Fail-closed media scanner, off by default — see docs/media-scanner.md before enabling.
mediaScanner:
  enabled: false
  replicas: 1
  # vectorim/matrix-content-scanner:v1.3.0
  image: "docker.io/vectorim/matrix-content-scanner@sha256:dd73aa09d9cd8fe0be50a7f67466bb31aa677320aa4d8f3b1dc2efb267fc214c"
  # clamav/clamav:1.5.4
  clamavImage: "docker.io/clamav/clamav@sha256:78810772a92b4a9168115bc6b2e0ffd702640893b9577f8c3d0432762d2655c4"
  clamavPort: 3310
  clamavTimeoutSeconds: 60
  matrixApiUrl: "http://matrix-synapse:8008"
  allowedMimeTypes:
    - "image/jpeg"
    - "image/png"
    - "image/webp"
    - "image/gif"
  blockDirectMediaAccess: true
  proxyTimeoutSeconds: 120
  maxUploadSize: "25m"
  requestSecret:
    existingSecret: ""
    key: "request-secret"
  aiCheck:
    enabled: false
    subProcessorAgreementSigned: false
    endpoint: "https://api.mistral.ai/v1/chat/completions"
    model: "pixtral-12b-2409"
    timeoutSeconds: 20
    existingSecret: ""
    key: "api-key"
  resultCache:
    maxSize: 1024
    ttl: "1h"
  resources:
    requests:
      cpu: "100m"
      memory: "256Mi"
    limits:
      cpu: "500m"
      memory: "512Mi"
  clamavResources:
    requests:
      cpu: "200m"
      memory: "1Gi"
    limits:
      cpu: "1"
      memory: "2Gi"

# ---------- Infrastructure Services ----------------------------------------------------------------------------------

admin:
  replicas: 1
  imageName: "ghcr.io/openresilienceinitiative/oriso-admin"
  imageVersion: "dev"
# MongoDB
online-counseling-mongodb:
  imageName: "mongo"
  imageVersion: "5.0"

# MariaDB
online-counseling-mariadb:
  imageName: "mariadb"
  imageVersion: "11.0.6"
  maxconnections: "1000"
matrixrtcAuth:
  replicas: 1
  membershipReaderUserId: "@matrixrtc-auth:your-server.local"
  # Namespace of the ingress controller, needed by the NetworkPolicy.
  ingressControllerNamespace: "ingress-nginx"
  bootstrap:
    enabled: true
    backoffLimit: 6
  existingSecret:
    name: "matrixrtc-auth-secrets"
    membershipTokenKey: "matrix-membership-token"
    callPolicyTokenKey: "call-policy-token"
    livekitApiKeyKey: "livekit-api-key"
    livekitApiSecretKey: "livekit-api-secret"
    redisUrlKey: "redis-url"
  # Pinned by digest — these images are the LiveKit authorization boundary.
  gateway:
    image: "ghcr.io/openresilienceinitiative/matrixrtc-auth-policy-gateway@sha256:2bc86a3a178d26fbc8ab09887c75bc2f1dd8e2b6e41cacf836bad060124fec06"
    pullPolicy: ""
  upstream:
    image: "ghcr.io/openresilienceinitiative/matrixrtc-authorization-service@sha256:d62ecfd22cfbc2081d3814e63fc7fe2d969aab9fbba54881cd51552d971fd714"
    pullPolicy: ""
  service:
    port: 3010
    targetPort: 3010
    type: ClusterIP

livekit:
  replicas: 1
  # hostNetwork ports — the replica must fully terminate before its replacement starts.
  deploymentStrategy: Recreate
  terminationGracePeriodSeconds: 60
  image: "docker.io/livekit/livekit-server:v1.13.5"
  existingConfigSecret:
    # Pre-provision this Secret outside Helm for the same release-history boundary.
    name: "livekit-config-runtime"
    key: "config.yaml"

# RabbitMQ
online-counseling-rabbitmq:
  imageName: "rabbitmq"
  imageVersion: "3-management"

# Redis
online-counseling-redis:
  imageName: "redis"
  imageVersion: "7-alpine"
  serviceURL: "redis://redis:6379"

# Keycloak
online-counseling-keycloak:
  imageName: "ghcr.io/openresilienceinitiative/oriso-keycloak"
  imageVersion: "26.6.3-otp"

  dbVendor: "mariadb"
  dbServer: "mariadb"
  dbDatabase: "keycloak"

  # Log levels: ALL, DEBUG, ERROR, FATAL, INFO, OFF, TRACE, WARN
  keycloakLogLevel: "WARN"
  rootLogLevel: "WARN"


# ---------- Backend Services -----------------------------------------------------------------------------------------


# Agency service
agencyService:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-agencyservice:dev"

  keycloakResource: "agency-service"

  springProfilesActive: "prod"
  liquibaseChangeLog: "classpath:db/changelog/agencyservice-master.xml"
  liquibaseContexts: "seed"

  topicEnrichmentEnabled: "false"

  agencyDeleteworkflowCron: "0 20 4 * * *"


# ConsultingType service
consultingTypeService:
  replicas: 1
  imageName: "ghcr.io/openresilienceinitiative/oriso-consultingtypeservice"
  imageVersion: "dev"
  serviceURL: "http://consultingtypeservice:8080"

  keycloakResource: "consultingtype-service"

  consultingTypesJsonPath : "consulting-type-settings"
  liquibaseChangeLog: "classpath:db/changelog/consultingtypeservice-master.xml"
  liquibaseContexts: "seed"
  bootstrapTopics:
    enabled: true


# Tenant Service
tenantService:
  replicas: 1
  imageName: "ghcr.io/openresilienceinitiative/oriso-tenantservice"
  imageVersion: "dev"
  springProfilesActive: "prod"
  liquibaseChangeLog: "classpath:db/changelog/tenantservice-master.xml"
  liquibaseContexts: "seed"
  bootstrapTenants:
    enabled: true
  springDatasourceURL: "jdbc:mariadb://mariadb:3306/tenantservice"
  springRabbitmqHost: "rabbitmq"
  springRabbitmqPort: "5672"


# User service
userService:
  # Provision/rotate this existing Secret outside anonymous requests before enabling
  # the new identity suggestions UI. Without it, suggestions fail closed with 503.
  # The Synapse credential has admin privileges; the lookup code uses only GET.
  identitySuggestions:
    matrixAdminTokenSecret:
      name: ""
      key: "access-token"
  # Per client IP and ingress-controller replica, shared by the two public entry paths.
  # Other UserService routes retain their existing policy.
  publicEntryRateLimit:
    requestsPerSecond: 5
    burstMultiplier: 2
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-userservice:dev"
  serviceURL: "http://userservice:8080"

  keycloakResource: "user-service"

  springProfilesActive: "prod"

  # Encryption must never be disabled in any environment.
  matrixEncryptionEnabled: "true"

  springRabbitmqHost: "rabbitmq"
  springRabbitmqPort: "5672"

  redisHost: "redis"
  redisPort: 6379
  consultantAvailabilityRedisTtlSeconds: 120

  # ADR-018 Global Support Access — see runbooks/support-access-enablement.md.
  supportAccess:
    enabled: "false"
    handshakeTtlSeconds: 300
    sessionTtlHours: 4
    auditRetentionMonths: 12

  # ADR-016 addendum (2026-09-05) / KDG #1116: team discussion archive purge. Days after
  # archiving until an ARCHIVED discussion's room, row and participants are deleted (OPEN ones
  # are never purged); 0 or less switches the job off.
  # Ships OFF (0) until the data protection officer signs off the retention period. The DPIA
  # proposal is 90; set that value in the environment overlay once approved.
  teamDiscussion:
    archiveRetentionDays: 0

  # 2FA / OTP login posture — enabled by default.
  otpAllowedForUsers: "true"
  otpAllowedForConsultants: "true"
  otpAllowedForSingleTenantAdmins: "true"
  otpAllowedForTenantSuperAdmins: "true"
  otpAllowedForRestrictedAgencyAdmins: "true"

  # Mail-link base URLs. Empty = derived from global.domainName
  # (<scheme>://<domainName>, admin reset <scheme>://<domainName>/admin; scheme
  # https, or http when global.enableTls is false). Set them only
  # when App or Admin live on another host; explicit values are validated.
  magicLinkFrontendBaseUrl: ""
  passwordResetFrontendBaseUrl: ""
  passwordResetAdminFrontendBaseUrl: ""

  # SMTP is environment-owned; setting a host requires credentials in secrets.
  smtpHost: ""
  smtpPort: 587
  smtpSecure: false
  smtpFrom: ""

  # Bare origins for account-invite links (admin must NOT end in /admin).
  # Empty = <scheme>://<domainName> (http when global.enableTls is false); set
  # only when the Admin panel has its own host.
  accountInviteAppFrontendBaseUrl: ""
  accountInviteAdminFrontendBaseUrl: ""

  # Platform-level email branding for mails without a tenant context.
  emailBrandingName: "ORISO"
  # Absolute https URL of the platform logo; empty = mails render without a logo.
  emailBrandingLogoUrl: ""

  firebaseConfigurationCredentialsFilePath: "/firebase/firebase-credentials.json"
  firebaseConfigurationNotificationMessage: "Du hast eine neue Nachricht erhalten"

  consultantImportFilename: "import/consultants.csv"
  consultantImportProtocolFilename: "import/consultants-import.txt"
  askerImportFilename: "import/askers.csv"
  askerImportWithoutSessionFilename: "import/askers-without-session.csv"
  askerImportProtocolFilename: "import/askers-import.txt"
  askerImportWelcomeMessageFilename: "import/welcome_consulting_type_[ConsultingType].txt"
  askerImportWelcomeMessageFilenameReplaceValue: "[ConsultingType]"

  sessionInactiveDeleteWorkflowEnabled: "false"
  sessionInactiveDeleteWorkflowCron: "0 0 * * * ?"
  sessionInactiveDeleteWorkflowCheckDays: "30"

# ---------- Frontend Services ----------------------------------------------------------------------------------------

# Frontend
frontend:
  replicas: 1
  image: "ghcr.io/openresilienceinitiative/oriso-frontend:dev"

nginxController:
  enabled: true
  replicas: 1


# ---------- Observability & Monitoring -------------------------------------------------------------------------------

# SigNoz — set signoz.enabled=true to deploy it and auto-enable OTLP export.
signoz:
  enabled: false
  # UI is served at https://<global.domainName>/signoz — keep in sync per environment.
  signoz:
    env:
      signoz_global_external__url: "https://your-domain.example.com/signoz"
  telemetryStoreMigrator:
    upgradeHelmHooks: false
  clickhouse:
    persistence:
      size: 20Gi

# Official SigNoz Kubernetes collection layer. Keep this separate switch
# fail-closed: observability-validation.yaml rejects enabling it without the
# bundled SigNoz backend and complete environment identity.
k8s-infra:
  enabled: false
  global:
    clusterName: ""
    deploymentEnvironment: ""
    cloud: other
  # Empty is intentional. As a dependency the chart derives the sibling
  # service `http://<release>-signoz-otel-collector:4318` (otlphttp).
  otelCollectorEndpoint: null
  otelInsecure: true
  presets:
    otlpExporter:
      enabled: false
    otlphttpExporter:
      enabled: true
    selfTelemetry:
      metrics:
        enabled: true
    logsCollection:
      enabled: true
      startAt: end
      includeFilePath: true
      includeFileName: false
      whitelist:
        enabled: true
        signozLogs: false
        namespaces:
          - '${env:K8S_NAMESPACE}'
        pods: []
        containers: []
        additionalInclude: []
      blacklist:
        enabled: true
        signozLogs: true
        namespaces:
          - kube-system
        pods: []
        containers: []
        additionalExclude: []
      operators:
        - id: container-parser
          type: container
    hostMetrics:
      enabled: true
    kubeletMetrics:
      enabled: true
    kubernetesAttributes:
      enabled: true
    clusterMetrics:
      enabled: true
    k8sEvents:
      enabled: true
      namespaces:
        - '${env:K8S_NAMESPACE}'
  otelAgent:
    clusterRole:
      rules:
        - apiGroups:
            - ""
          resources:
            - pods
            - namespaces
            - nodes
            - persistentvolumeclaims
          verbs:
            - get
            - list
            - watch
        - apiGroups:
            - apps
            - extensions
          resources:
            - replicasets
          verbs:
            - get
            - list
            - watch
        - apiGroups:
            - batch
          resources:
            - jobs
          verbs:
            - get
            - list
            - watch
        - apiGroups:
            - ""
          resources:
            - nodes/stats
            - nodes/proxy
          verbs:
            - get
    # No hostPorts: probes and self-telemetry use the pod IP, nothing binds on the node.
    ports:
      otlp:
        enabled: false
        hostPort: ""
      otlp-http:
        enabled: false
        hostPort: ""
      zipkin:
        enabled: false
        hostPort: ""
      metrics:
        hostPort: ""
      health-check:
        hostPort: ""
      zpages:
        hostPort: ""
      pprof:
        hostPort: ""
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    # Pod logs are 0640 root:root. Group 0 reads them without UID 0 or any
    # capability (a capability added for a non-root UID is not effective in
    # Kubernetes without ambient caps). Proven only on a live node (Pre-Dev).
    podSecurityContext:
      runAsNonRoot: true
      runAsUser: 10001
      runAsGroup: 0
      seccompProfile:
        type: RuntimeDefault
    securityContext:
      runAsNonRoot: true
      runAsUser: 10001
      runAsGroup: 0
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      seccompProfile:
        type: RuntimeDefault
      capabilities:
        drop:
          - ALL
    config:
      processors:
        # ORISO application stdout is nested JSON. Preserve technical
        # correlation and severity while suppressing the raw free-text body,
        # stack trace, request correlation ID, and every unlisted attribute.
        #
        # error_mode: ignore — a single malformed record must not drop the
        # whole log batch. ParseJSON fails on truncated JSON and the
        # trace_id/span_id setters reject non-hex ids; with `propagate` those
        # OTTL errors are returned to the pipeline and the entire batch is
        # discarded. With `ignore` the collector logs the failing statement and
        # continues, so the unconditional body replacement and keep_keys below
        # still run: the privacy contract stays fail-closed per record.
        transform/oriso_log_privacy:
          error_mode: ignore
          log_statements:
            - 'set(log.cache, ParseJSON(log.body)) where IsMatch(log.body, "^\\s*\\{")'
            - 'set(log.attributes["trace.id"], log.cache["traceId"]) where log.cache["traceId"] != nil'
            - 'set(log.attributes["span.id"], log.cache["spanId"]) where log.cache["spanId"] != nil'
            - 'set(log.trace_id.string, log.cache["traceId"]) where log.cache["traceId"] != nil'
            - 'set(log.span_id.string, log.cache["spanId"]) where log.cache["spanId"] != nil'
            - 'set(log.attributes["log.level"], log.cache["log"]["level"]) where log.cache["log"]["level"] != nil'
            - 'set(log.severity_text, log.cache["log"]["level"]) where log.cache["log"]["level"] != nil'
            - 'set(log.attributes["log.logger"], log.cache["log"]["logger"]) where log.cache["log"]["logger"] != nil'
            - 'set(log.attributes["service.name"], log.cache["serviceName"]) where log.cache["serviceName"] != nil'
            - 'set(log.body, "[ORISO log body suppressed by privacy policy]")'
            - 'keep_keys(log.attributes, ["trace.id", "span.id", "log.level", "log.logger", "service.name"])'
      service:
        telemetry:
          resource:
            service.name: oriso-k8s-infra-agent
            deployment.environment: '${env:DEPLOYMENT_ENVIRONMENT}'
        pipelines:
          traces:
            receivers: []
            processors:
              - batch
            exporters: []
          metrics:
            receivers: []
            processors:
              - batch
            exporters: []
          logs:
            receivers: []
            processors:
              - transform/oriso_log_privacy
              - batch
            exporters: []
  otelDeployment:
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      runAsNonRoot: true
      capabilities:
        drop:
          - ALL
    config:
      service:
        telemetry:
          resource:
            service.name: oriso-k8s-infra-cluster
            deployment.environment: '${env:DEPLOYMENT_ENVIRONMENT}'

# Health Dashboard
healthDashboard:
  ingress:
    # Public access is opt-in; every enabled ingress requires Basic Auth.
    enabled: false
    # Existing Secret with an nginx-compatible `auth` htpasswd entry, provisioned
    # in healthDashboard.namespace (or the release namespace when unset).
    authSecret: ""
  image:
    repository: ghcr.io/openresilienceinitiative/health-dashboard
    tag: dev
    pullPolicy: ""
  replicas: 1
  namespace: ""
  resources: {}
  service:
    type: ClusterIP
    port: 9100
    targetPort: 9100
  env:
    PORT: "9100"
    HEALTH_CHECK_TIMEOUT_MS: "5000"
