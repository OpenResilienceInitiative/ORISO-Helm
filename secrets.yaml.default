global:
  keycloak:

    serviceTechUserId: "changeme"

  secrets:
    liquibaseUser: "liquibase"
    liquibasePassword: "changeme"

    rabbitmqUsername: "admin"
    rabbitmqPassword: "changeme"

    caritasDbUsername: "caritas"
    caritasDbPassword: "changeme"
    keycloakDbUsername: "keycloak"
    keycloakDbPassword: "changeme"
    agencyServiceDbUsername: "aservice"
    agencyServiceDbPassword: "changeme"
    consultingTypeServiceDbUsername: "ctservice"
    consultingTypeServiceDbPassword: "changeme"
    consultingTypeMongoUser: "consulting_types"
    consultingTypeMongoPass: "changeme"
    userServiceDbUsername: "uservice"
    userServiceDbPassword: "changeme"
    uploadServiceDbUsername: "upservice"
    uploadServiceDbPassword: "changeme"
    tenantServiceDbUsername: "tservice"
    tenantServiceDbPassword: "changeme"
    redisdefaultPass: "changeme"
    matrixRegistrationSharedSecret: "changeme"
    keycloakAdminUsername: "realmadmin"
    keycloakAdminPassword: "changeme"

  # Must live under global: so the mariadb subchart can read it too
  matrix:
    matrixAdminUsername: "matrixadm"
    matrixAdminPassword: "changeme"


postgres:
  postgresDB: "changeme"
  postgresPassword: "changeme"
  postgresUser: "changeme"


online-counseling-mongodb:
  mongoSharedKey: "ChangeMeMongoReplicaKey2026"
  mongoInitDbRootUsername: "admin"
  mongoInitDbRootPassword: "changeme"
  noSqlClientMongoUsername: "nosqlclient"
  noSqlClientMongoPassword: "changeme"
  oplogMongoUsername: "oplog"
  oplogMongoPassword: "changeme"
  statisticsMongoUser: "statistics"
  statisticsMongoPass: "changeme"


online-counseling-mariadb:
  dbRootPassword: "changeme"

matrixrtcAuth:
  # Password for matrixrtcAuth.membershipReaderUserId. Helm uses this with the
  # Matrix shared registration secret to bootstrap the user and write its access
  # token into matrixrtc-auth-secrets during install.
  membershipReaderPassword: "changeme"
  # Optional manual Matrix access token override. Leave blank/changeme to let
  # the Helm bootstrap job create and patch the token automatically.
  membershipToken: ""
  # Dedicated shared secret between the MatrixRTC policy gateway and
  # UserService. Generate an independent high-entropy value for every
  # environment; never reuse a LiveKit, Matrix, or application credential.
  callPolicyToken: "changeme"
  # Optional override for external Redis. Leave blank to use the in-chart Redis
  # Service and global.secrets.redisdefaultPass.
  redisUrl: ""

livekit:
  api:
    key: "changeme"
    secret: "changeme"

tenantService:
  springDatasourceUsername: "caritas"
  springDatasourcePassword: "changeme"
  springRabbitmqUsername: "admin"
  springRabbitmqPassword: "changeme"


agencyService:
  # Required by AgencyService AS-C01 to encrypt Matrix service-account passwords at rest.
  # The chart marks this `required`: a blank value fails the deploy rather than
  # rendering a Secret with an empty key (see ORISO-Helm#49).
  # Rotating it makes every already-stored `enc:` agency credential
  # undecryptable, so re-provision those accounts when you change it.
  serviceEncryptionAppkey: "changeme"

userService:
  keycloakTechnicalUsername: "technical"
  keycloakTechnicalPassword: "changeme"
  serviceEncryptionAppkey: "changeme"
  # Mandatory boot config. ConsultantIdentityHasher HMACs the consultant id
  # before it reaches message-count statistics, and its @PostConstruct throws
  # on a null/blank secret — application.properties maps the property to
  # `${STATISTICS_MESSAGE_COUNT_HMAC_SECRET:}` (empty default), so a UserService
  # started without it exits 1 on every boot rather than degrading.
  # The chart marks this `required`: a missing or blank value fails the deploy
  # instead of rendering a Secret with an empty key and CrashLooping the pod
  # (same posture as agencyService.serviceEncryptionAppkey, ORISO-Helm#49).
  # Generate with e.g. `openssl rand -base64 32`. Rotating it re-pseudonymizes
  # every consultant id going forward, so already-stored statistics rows stop
  # matching the live hash — treat a rotation as a statistics-history reset.
  statisticsMessageCountHmacSecret: "changeme"
  identityTechnicalUserUsername: "changeme"
  identityTechnicalUserPassword: "changeme"
  smtpUser: ""
  smtpPassword: ""
